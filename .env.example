# Variables para docker-compose.yml. Copiar a .env en la raíz (en el VPS lo sube el Makefile).
DB_PASSWORD=cambiame
AUTH_SECRET=cambiame-por-un-secreto-largo
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MP_ACCESS_TOKEN=TEST-xxx
MP_WEBHOOK_SECRET=xxx
