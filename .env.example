# Variables para docker-compose.yml. Copiar a .env en la raíz (en el VPS lo sube el Makefile).
DB_PASSWORD=cambiame
AUTH_SECRET=cambiame-por-un-secreto-largo
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MP_ACCESS_TOKEN=TEST-xxx
MP_WEBHOOK_SECRET=xxx
FRONTEND_URL=https://academia.flynnpedroa.engineer
# Emails (separados por coma) que quedan admin al loguearse. Default en compose: el del dueño.
ADMIN_EMAILS=pepeflynn22@gmail.com

# Puertos del host (solo 127.0.0.1). En el VPS el 3000 está ocupado: usar WEB_PORT=3200.
WEB_PORT=3000
API_PORT=4000

# Solo en el VPS: activa el servicio cloudflared (profile "tunnel") con el token del tunnel
# creado en Cloudflare Zero Trust → Networks → Tunnels.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
