---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { type Certificate, formatDate, getCertificate } from '~/lib/api';

const id = Astro.params.id ?? '';

let certificate: (Certificate & { verifyUrl: string }) | null;
try {
  certificate = await getCertificate(id);
} catch (err) {
  console.error(`No se pudo cargar el certificado ${id}`, err);
  return new Response('No pudimos cargar el certificado. Probá de nuevo en un rato.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
if (!certificate) return new Response(null, { status: 404 });
---

<Base
  title={`Certificado: ${certificate.recipientName} — ${certificate.courseTitle} — La Forja`}
  description={`${certificate.recipientName} completó el curso "${certificate.courseTitle}" de La Forja.`}
>
  {/* Es público para poder compartirlo, pero no hace falta que el nombre de la persona quede indexado. */}
  <meta slot="head" name="robots" content="noindex" />
  <Nav />
  <main class="cert container">
    <section class="cert__card">
      <div class="eyebrow">Certificado verificado</div>
      <h1 class="cert__name display">{certificate.recipientName}</h1>
      <p class="cert__text">
        completó el curso <a href={`/cursos/${certificate.courseSlug}`}>{certificate.courseTitle}</a>
        el {formatDate(certificate.issuedAt)}.
      </p>
      <p class="cert__id mono">ID {certificate.id}</p>
      <div class="cert__ctas">
        <a href={`/certificados/${certificate.id}.pdf`} class="btn btn--primary" download>Descargar PDF</a>
        <a href={`/cursos/${certificate.courseSlug}`} class="btn btn--ghost">Ver el curso</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .cert {
    max-width: 680px;
    padding-block: clamp(60px, 10vw, 120px);
  }
  .cert__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(28px, 5vw, 44px);
    border: 1px solid rgba(255,176,103,0.3);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    box-shadow: var(--shadow-glow);
  }
  .cert__name { font-size: clamp(34px, 6vw, 52px); line-height: 1.05; overflow-wrap: anywhere; }
  .cert__text { color: var(--ink-dim); font-size: 18px; }
  .cert__text a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--ember-500); text-underline-offset: 3px; }
  .cert__id { color: var(--ink-mute); font-size: 12px; overflow-wrap: anywhere; }
  .cert__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
