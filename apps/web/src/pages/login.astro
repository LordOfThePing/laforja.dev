---
import { getSession } from 'auth-astro/server';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';

const session = await getSession(Astro.request);
if (session?.user) {
  return Astro.redirect('/');
}
---

<Base>
  <Nav />
  <main class="login">
    <div class="login__card">
      <h1 class="login__title">Ingresá a La Forja</h1>
      <p class="login__lede">
        Con tu cuenta de Google desbloqueás dos herramientas gratis por mes.
        Una suscripción te habilita el acceso ilimitado.
      </p>

      <button id="google-signin" class="btn btn--primary login__cta" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.4-.4-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.4 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.6 8.4 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.3 0-9.7-3.1-11.3-7.5l-6.5 5C9.6 39.6 16.3 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.1 5.6l6.2 5.2c-.4.4 6.6-4.8 6.6-14.8 0-1.2-.1-2.4-.4-3.5z"/>
        </svg>
        <span>Ingresar con Google</span>
      </button>

      <p class="login__fine">
        Solo usamos tu email para identificarte y guardar tu cupo mensual.
        Nunca lo compartimos.
      </p>
    </div>
  </main>
  <Footer />
</Base>

<script>
  import { signIn } from 'auth-astro/client';
  const btn = document.getElementById('google-signin');
  btn?.addEventListener('click', () => {
    // callbackUrl default = window.location.href. Como /login redirige a /
    // si ya hay sesion, el usuario termina en / despues del OAuth.
    signIn('google');
  });
</script>

<style>
  .login {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding-block: 80px;
  }
  .login__card {
    width: min(440px, 100%);
    padding: 40px 32px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .login__title {
    font-family: var(--font-display);
    font-size: 34px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .login__lede {
    color: var(--ink-dim);
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.55;
  }
  .login__cta {
    width: 100%;
    justify-content: center;
    gap: 12px;
  }
  .login__fine {
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--ink-faint, var(--ink-dim));
    line-height: 1.5;
    text-align: center;
  }
</style>
