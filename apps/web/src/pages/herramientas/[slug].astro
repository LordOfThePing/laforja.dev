---
import { getSession } from 'auth-astro/server';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import {
  ApiError,
  type Me,
  type ToolComments,
  type ToolDetail,
  deleteToolComment,
  formatDuration,
  getMe,
  getTool,
  getToolComments,
  postToolComment,
  unlockTool,
} from '~/lib/api';
import { loginUrl } from '~/lib/redirect';
import { youtubeEmbedUrl } from '~/lib/youtube';

const slug = Astro.params.slug ?? '';
const session = await getSession(Astro.request);
const user = session?.user;

type Notice = 'quota_exceeded' | 'rate_limited' | 'unauthorized';
let notice: Notice | null = null;
type CommentNotice = 'invalid_body' | 'rate_limited' | 'subscription_required' | 'unauthorized';
let commentNotice: CommentNotice | null = null;
let draft = '';

if (Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(loginUrl(Astro.url.pathname));
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'comment' || action === 'delete-comment') {
    const body = form.get('body');
    const id = form.get('id');
    if (action === 'comment') draft = typeof body === 'string' ? body : '';
    const result =
      action === 'comment'
        ? await postToolComment(user, slug, draft)
        : await deleteToolComment(user, slug, typeof id === 'string' ? id : '');
    // Borrar algo que ya no está (doble click, otra pestaña) no es un error para quien mira.
    if (result.ok || (action === 'delete-comment' && result.reason === 'not_found')) {
      return Astro.redirect(`/herramientas/${slug}#comentarios`, 303);
    }
    if (result.reason === 'not_found') return new Response(null, { status: 404 });
    commentNotice = result.reason;
    Astro.response.status = { invalid_body: 400, rate_limited: 429, subscription_required: 403, unauthorized: 401 }[
      result.reason
    ];
  } else {
    // El form de desbloqueo no manda action.
    const result = await unlockTool(user, slug);
    if (result.ok) return Astro.redirect(`/herramientas/${slug}`, 303);
    if (result.reason === 'not_found') return new Response(null, { status: 404 });
    notice = result.reason;
    Astro.response.status = result.reason === 'rate_limited' ? 429 : 403;
  }
}

let tool: ToolDetail | null;
let me: Me | null = null;
// En paralelo con la herramienta aunque todavía no se sepa si está bloqueada: si lo está, la API
// responde 403 y no hay sección. Si falla por otra cosa, la herramienta se ve igual.
let comments: ToolComments | null = null;
const commentsLoad = getToolComments(user, slug).catch((err: unknown) => {
  if (!(err instanceof ApiError && (err.status === 403 || err.status === 404))) {
    console.error(`No se pudieron cargar los comentarios de ${slug}`, err);
  }
  return null;
});
try {
  [tool, me, comments] = await Promise.all([getTool(user, slug), getMe(user), commentsLoad]);
} catch (err) {
  console.error(`No se pudo cargar la herramienta ${slug}`, err);
  return new Response('No pudimos cargar la herramienta. Probá de nuevo en un rato.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
if (!tool) {
  Astro.response.status = 404;
}

const duration = tool ? formatDuration(tool.durationSeconds) : null;
const embed = tool && !tool.isLocked ? youtubeEmbedUrl(tool.youtubeUrl) : null;
const paragraphs = tool && !tool.isLocked ? (tool.longDescription?.split(/\n{2,}/) ?? []) : [];
const remaining = me?.unlocks.remaining ?? 0;
const quotaText = remaining === 1 ? 'Te queda' : 'Te quedan';
const outOfQuota = notice === 'quota_exceeded' || (me !== null && remaining === 0);
const gate: 'login' | 'quota' | 'unlock' = !user ? 'login' : outOfQuota ? 'quota' : 'unlock';

const commentDate = new Intl.DateTimeFormat('es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Argentina/Buenos_Aires',
});
const commentErrors: Record<CommentNotice, string> = {
  invalid_body: 'El comentario no puede estar vacío ni pasar de 2000 caracteres.',
  rate_limited: 'Estás comentando muy seguido. Esperá un minuto y probá de nuevo.',
  subscription_required: 'Comentar es para suscriptores.',
  unauthorized: 'Tu sesión venció. Salí y volvé a ingresar.',
};
---

<Base
  title={tool ? `${tool.title} — La Forja` : 'Herramienta no encontrada — La Forja'}
  description={tool?.shortDescription}
  image={tool ? `/og/herramientas/${encodeURIComponent(tool.slug)}.png` : undefined}
>
  <Nav />
  <main class="tool container">
    <a href="/#herramientas" class="tool__back mono">← Volver al catálogo</a>

    {!tool ? (
      <section class="tool__empty">
        <h1 class="tool__title display">No encontramos esta herramienta.</h1>
        <p class="tool__lede">Puede que el link esté mal o que todavía no esté publicada.</p>
      </section>
    ) : (
      <article>
        <header class="tool__head">
          <div class="tool__meta">
            <span class:list={['pill', tool.tier === 'premium' ? 'pill--ember' : 'pill--spark']}>
              {tool.tier === 'premium' ? 'Premium' : 'Gratis'}
            </span>
            <span class="mono tool__cat">{tool.category.name}</span>
            {duration && <span class="mono tool__cat">{duration}</span>}
          </div>
          <h1 class="tool__title display">{tool.title}</h1>
          <p class="tool__lede">{tool.shortDescription}</p>
          <div class="tool__tags">
            {tool.tags.map((t) => <span class="mono">#{t}</span>)}
          </div>
        </header>

        {tool.isLocked ? (
          <section class="gate" aria-labelledby="gate-title">
            <div class="gate__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 10V7a6 6 0 1 1 12 0v3M5 10h14v10H5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>

            {gate === 'login' && (
              <>
                <h2 id="gate-title" class="gate__title">Ingresá para abrir esta herramienta</h2>
                <p class="gate__text">
                  Con tu cuenta de Google desbloqueás dos herramientas premium gratis por mes.
                </p>
                <a href={loginUrl(Astro.url.pathname)} class="btn btn--primary">Ingresar con Google</a>
              </>
            )}
            {gate === 'quota' && (
              <>
                <h2 id="gate-title" class="gate__title">Ya usaste tus 2 desbloqueos de este mes</h2>
                <p class="gate__text">
                  El cupo se renueva el día 1. Si no querés esperar, con la suscripción
                  tenés acceso a toda la biblioteca.
                </p>
                <a href="/suscripcion" class="btn btn--primary">Suscribirme</a>
              </>
            )}
            {gate === 'unlock' && (
              <>
                <h2 id="gate-title" class="gate__title">Desbloqueala con tu cupo mensual</h2>
                <p class="gate__text">
                  {quotaText} <strong>{remaining} de {me?.unlocks.limit ?? 2}</strong> desbloqueos
                  este mes. Una vez desbloqueada, la tenés hasta fin de mes.
                </p>
                {notice === 'rate_limited' && (
                  <p class="gate__error" role="alert">Demasiados intentos seguidos. Esperá un minuto y probá de nuevo.</p>
                )}
                {notice === 'unauthorized' && (
                  <p class="gate__error" role="alert">Tu sesión venció. Salí y volvé a ingresar.</p>
                )}
                <form method="post">
                  <button type="submit" class="btn btn--primary">Desbloquear herramienta</button>
                </form>
              </>
            )}
          </section>
        ) : (
          <>
            {embed && (
              <div class="tool__video">
                <iframe
                  src={embed}
                  title={`Video: ${tool.title}`}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            )}

            {paragraphs.length > 0 && (
              <section class="tool__body">
                {paragraphs.map((p) => <p>{p}</p>)}
              </section>
            )}

            <section class="prompt" aria-labelledby="prompt-title">
              <header class="prompt__head">
                <h2 id="prompt-title" class="eyebrow">Prompt</h2>
                <button type="button" class="btn btn--ghost prompt__copy" data-copy-target="prompt-body">
                  Copiar
                </button>
              </header>
              <pre class="prompt__body"><code id="prompt-body">{tool.promptBody}</code></pre>
            </section>

            {comments && (
              <section id="comentarios" class="comments" aria-labelledby="comments-title">
                <h2 id="comments-title" class="comments__title">
                  Comentarios
                  {comments.comments.length > 0 && <span class="mono comments__count">{comments.comments.length}</span>}
                </h2>

                {comments.canComment ? (
                  <form method="post" class="comments__form">
                    <input type="hidden" name="action" value="comment" />
                    <label class="sr-only" for="comment-body">Tu comentario</label>
                    <textarea
                      id="comment-body"
                      name="body"
                      required
                      maxlength="2000"
                      rows="3"
                      placeholder="¿Cómo la usaste? ¿Qué le cambiaste?"
                    >{draft}</textarea>
                    {commentNotice && (
                      <p class="comments__error" role="alert">{commentErrors[commentNotice]}</p>
                    )}
                    <button type="submit" class="btn btn--primary">Comentar</button>
                  </form>
                ) : (
                  <p class="comments__hint">
                    {user ? (
                      <>Comentar es para suscriptores. <a href="/suscripcion">Suscribite</a> para sumarte a la conversación.</>
                    ) : (
                      <><a href={loginUrl(Astro.url.pathname)}>Ingresá</a> con tu suscripción para comentar.</>
                    )}
                  </p>
                )}

                {comments.comments.length === 0 ? (
                  <p class="comments__empty">Todavía no hay comentarios.</p>
                ) : (
                  <ol class="comments__list">
                    {comments.comments.map((c) => (
                      <li class="comment">
                        {c.author.avatarUrl ? (
                          <img class="comment__avatar" src={c.author.avatarUrl} alt="" loading="lazy" referrerpolicy="no-referrer" />
                        ) : (
                          <span class="comment__avatar comment__avatar--initial" aria-hidden="true">{c.author.name[0]}</span>
                        )}
                        <div class="comment__main">
                          <div class="comment__meta">
                            <span class="comment__author">{c.author.name}</span>
                            <time class="mono" datetime={c.createdAt}>{commentDate.format(new Date(c.createdAt))}</time>
                            {c.isMine && <span class="mono comment__mine">Vos</span>}
                          </div>
                          <p class="comment__body">{c.body}</p>
                          {c.canDelete && (
                            <form method="post" class="comment__delete">
                              <input type="hidden" name="action" value="delete-comment" />
                              <input type="hidden" name="id" value={c.id} />
                              <button type="submit" class="comment__delete-btn">Borrar</button>
                            </form>
                          )}
                        </div>
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            )}
          </>
        )}
      </article>
    )}
  </main>
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copyTarget ?? '');
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        btn.textContent = '¡Copiado!';
      } catch {
        btn.textContent = 'No se pudo copiar';
      }
      setTimeout(() => (btn.textContent = 'Copiar'), 1800);
    });
  });
</script>

<style>
  .tool {
    max-width: 820px;
    padding-block: clamp(40px, 6vw, 80px);
  }
  .tool__back {
    display: inline-block;
    color: var(--ink-mute);
    margin-bottom: 32px;
    transition: color 200ms var(--ease-out);
  }
  .tool__back:hover { color: var(--ink); }

  .tool__head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; }
  .tool__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
  .tool__cat {
    color: var(--ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
  }
  .tool__title {
    font-size: clamp(36px, 6vw, 60px);
    line-height: 1.05;
  }
  .tool__lede { color: var(--ink-dim); font-size: 18px; max-width: 640px; }
  .tool__tags { display: flex; flex-wrap: wrap; gap: 10px; color: var(--ink-mute); font-size: 12px; }

  .tool__video {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    margin-bottom: 40px;
    background: var(--bg-elev);
  }
  .tool__video iframe { width: 100%; height: 100%; border: 0; }

  .tool__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink-dim);
    margin-bottom: 40px;
  }

  .prompt {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    overflow: hidden;
  }
  .prompt__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
  }
  .prompt__copy { padding: 6px 14px; font-size: 13px; }
  .prompt__body {
    padding: 22px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  .gate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 32px;
    border: 1px solid rgba(255,176,103,0.25);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255,122,0,0.07), rgba(255,122,0,0.01));
  }
  .gate__icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--ember-500), var(--ember-600));
    color: #1a0e00;
    box-shadow: 0 10px 30px -8px var(--ember-glow);
  }
  .gate__title { font-family: var(--font-display); font-size: 30px; line-height: 1.1; font-weight: 400; }
  .gate__text { color: var(--ink-dim); max-width: 520px; }
  .gate__text strong { color: var(--ember-300); }
  .gate__error { color: var(--ember-300); font-size: 14px; }

  .tool__empty { display: flex; flex-direction: column; gap: 16px; }

  .comments { margin-top: 56px; display: flex; flex-direction: column; gap: 24px; scroll-margin-top: 96px; }
  .comments__title { display: flex; align-items: baseline; gap: 12px; font-family: var(--font-display); font-size: 32px; font-weight: 400; }
  .comments__count { color: var(--ink-mute); font-size: 13px; }
  .comments__form { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .comments__form textarea {
    width: 100%;
    min-height: 96px;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--ink);
    font: inherit;
    resize: vertical;
    transition: border-color 200ms var(--ease-out);
  }
  .comments__form textarea:focus-visible { outline: 2px solid var(--ember-500); outline-offset: 1px; }
  .comments__error { color: var(--ember-300); font-size: 14px; }
  .comments__hint, .comments__empty { color: var(--ink-dim); }
  .comments__hint a { color: var(--ember-300); text-decoration: underline; text-underline-offset: 3px; }

  .comments__list { list-style: none; display: flex; flex-direction: column; }
  .comment { display: flex; gap: 14px; padding-block: 20px; border-top: 1px solid var(--line); }
  .comment__avatar { flex: none; width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .comment__avatar--initial {
    display: grid;
    place-items: center;
    background: var(--bg-elev);
    border: 1px solid var(--line-strong);
    color: var(--ember-300);
    font-weight: 600;
    text-transform: uppercase;
  }
  .comment__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .comment__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; font-size: 14px; }
  .comment__author { font-weight: 600; }
  .comment__meta time { color: var(--ink-mute); font-size: 12px; }
  .comment__mine { color: var(--spark); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; }
  .comment__body { color: var(--ink-dim); white-space: pre-line; overflow-wrap: anywhere; }
  .comment__delete-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-mute);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .comment__delete-btn:hover { color: var(--ember-300); }
</style>
