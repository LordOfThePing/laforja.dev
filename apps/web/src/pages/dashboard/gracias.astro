---
import { getSession } from 'auth-astro/server';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { type Me, getMe } from '~/lib/api';
import { loginUrl } from '~/lib/redirect';

const session = await getSession(Astro.request);
const user = session?.user;
if (!user) return Astro.redirect(loginUrl('/dashboard/gracias'));

let me: Me | null = null;
try {
  me = await getMe(user);
} catch (err) {
  console.error('No se pudo cargar /api/me', err);
}

// MP redirige acá apenas se paga, pero la suscripción se activa cuando llega el webhook
// (auth-y-pagos.md). Mientras tanto la página se refresca sola para no mostrar "pendiente" de más.
const active = me?.subscription.status === 'active' && me.subscription.hasAccess;
---

<Base title="Gracias — La Forja">
  {!active && <meta slot="head" http-equiv="refresh" content="5" />}
  <Nav />
  <main class="thanks container">
    <section class="thanks__card">
      {active ? (
        <>
          <div class="eyebrow">Suscripción activa</div>
          <h1 class="thanks__title display">Listo. Ya tenés toda la biblioteca.</h1>
          <p class="thanks__text">
            Gracias por bancar La Forja. Cada herramienta está abierta para vos, sin cupo.
          </p>
          <div class="thanks__ctas">
            <a href="/#herramientas" class="btn btn--primary">Ir al catálogo</a>
            <a href="/dashboard" class="btn btn--ghost">Mi cuenta</a>
          </div>
        </>
      ) : (
        <>
          <div class="eyebrow">Confirmando el pago</div>
          <h1 class="thanks__title display">¡Gracias! Estamos esperando a MercadoPago.</h1>
          <p class="thanks__text">
            Suele tardar unos segundos. Esta página se actualiza sola; si en unos minutos no
            cambia, revisá el estado en tu cuenta.
          </p>
          <div class="thanks__ctas">
            <a href="/dashboard" class="btn btn--ghost">Mi cuenta</a>
          </div>
        </>
      )}
    </section>
  </main>
  <Footer />
</Base>

<style>
  .thanks {
    max-width: 640px;
    padding-block: clamp(60px, 10vw, 120px);
  }
  .thanks__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(28px, 5vw, 44px);
    border: 1px solid rgba(255,176,103,0.3);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    box-shadow: var(--shadow-glow);
  }
  .thanks__title { font-size: clamp(32px, 6vw, 48px); line-height: 1.05; }
  .thanks__text { color: var(--ink-dim); }
  .thanks__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
