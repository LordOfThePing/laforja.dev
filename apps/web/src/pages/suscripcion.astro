---
import { getSession } from 'auth-astro/server';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { type Me, createSubscription, formatDate, getMe } from '~/lib/api';
import { loginUrl } from '~/lib/redirect';

const session = await getSession(Astro.request);
const user = session?.user;
if (!user) return Astro.redirect(loginUrl('/suscripcion'));

let providerError = false;

if (Astro.request.method === 'POST') {
  const result = await createSubscription(user);
  if (result.ok) return Astro.redirect(result.initPoint, 303);
  if (result.reason === 'already_subscribed') return Astro.redirect('/dashboard', 303);
  providerError = true;
  Astro.response.status = 502;
}

let me: Me | null;
try {
  me = await getMe(user);
} catch (err) {
  console.error('No se pudo cargar /api/me', err);
  return new Response('No pudimos cargar tu cuenta. Probá de nuevo en un rato.', {
    status: 502,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const subscribed = me?.subscription.status === 'active' && me.subscription.hasAccess;
const periodEnd = formatDate(me?.subscription.currentPeriodEnd ?? null);
---

<Base title="Suscripción — La Forja">
  <Nav />
  <main class="sub container">
    {subscribed ? (
      <section class="panel">
        <div class="eyebrow">Suscripción</div>
        <h1 class="panel__title display">Ya sos suscriptor.</h1>
        <p class="panel__text">
          Tenés acceso ilimitado a toda la biblioteca{periodEnd && ` hasta el ${periodEnd}`}, y se renueva
          solo cada mes.
        </p>
        <a href="/dashboard" class="btn btn--ghost">Ir a mi cuenta</a>
      </section>
    ) : (
      <section class="panel panel--featured">
        <div class="eyebrow">Plan Artesano</div>
        <h1 class="panel__title display">Toda la biblioteca, sin cupo.</h1>
        <p class="panel__price">
          <span class="panel__price-num">$4.000</span>
          <span class="panel__price-per mono">ARS / mes</span>
        </p>
        <ul class="panel__feats">
          <li>Acceso ilimitado a todas las herramientas, sin gastar desbloqueos</li>
          <li>Cursos y módulos cuando lancen, sin costo extra</li>
          <li>Cancelás cuando quieras desde tu cuenta y mantenés el acceso hasta fin del período</li>
        </ul>

        {providerError && (
          <p class="panel__error" role="alert">
            MercadoPago no respondió. Probá de nuevo en unos minutos.
          </p>
        )}

        <form method="post">
          <button type="submit" class="btn btn--primary">
            Continuar a MercadoPago
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
        <p class="panel__fine mono">
          Pago recurrente con MercadoPago a nombre de {me?.user.email ?? user.email}.
        </p>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .sub {
    max-width: 640px;
    padding-block: clamp(48px, 8vw, 100px);
  }
  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(28px, 5vw, 44px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
  }
  .panel--featured {
    border-color: rgba(255,176,103,0.3);
    box-shadow: var(--shadow-glow);
  }
  .panel__title { font-size: clamp(34px, 6vw, 52px); line-height: 1.05; }
  .panel__text { color: var(--ink-dim); }
  .panel__price { display: flex; align-items: baseline; gap: 10px; }
  .panel__price-num { font-family: var(--font-display); font-size: 48px; line-height: 1; }
  .panel__price-per { color: var(--ink-mute); }
  .panel__feats {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-dim);
  }
  .panel__feats li::before { content: '✓  '; color: var(--ember-300); }
  .panel__error { color: var(--ember-300); font-size: 14px; }
  .panel__fine { color: var(--ink-mute); font-size: 11.5px; }
</style>
