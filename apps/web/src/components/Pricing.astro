---
// Pricing: tres niveles — Aprendiz (gratis), Oficial, Maestro.
import { type Plan, getPrices } from '~/lib/api';
import { PROVIDER_LABEL, REGION_PROVIDER, formatPrice, regionCurrency, resolveRegion } from '~/lib/pricing';

const pricing = await getPrices();
const region = resolveRegion(Astro.request, Astro.url, pricing);
const currency = regionCurrency(region);
const price = (plan: Plan) => (pricing ? formatPrice(pricing.prices[plan][currency], currency) : null);
const other = region === 'ar' ? 'intl' : 'ar';
const otherCurrency = regionCurrency(other);
const subscribeHref = `/suscripcion?region=${region}`;
---

<section id="suscripcion" class="pricing">
  <div class="container">
    <header class="pricing__head reveal">
      <div class="eyebrow">Suscripción</div>
      <h2 class="pricing__title display">
        Empezá gratis. <span class="pricing__title-em">Subí cuando te sirva.</span>
      </h2>
      <p class="pricing__desc">
        Entrás con Google y desbloqueás 1 herramienta por mes. Si querés más, pasás a Oficial o Maestro.
      </p>
    </header>

    <div class="pricing__grid">
      <article class="plan reveal">
        <header class="plan__head">
          <div class="plan__name">Aprendiz</div>
          <div class="plan__price">
            <span class="plan__price-num">Gratis</span>
          </div>
          <p class="plan__tag">Para probar y ver si va con vos.</p>
        </header>
        <ul class="plan__feats">
          <li><span class="plan__check">✓</span> 1 herramienta desbloqueada por mes</li>
          <li><span class="plan__check">✓</span> Preview completo del catálogo</li>
          <li><span class="plan__check">✓</span> Acceso a todas las herramientas <em>free</em></li>
        </ul>
        <a href="/login" class="btn btn--ghost plan__cta">Ingresar con Google</a>
      </article>

      <article class="plan reveal">
        <header class="plan__head">
          <div class="plan__name">Oficial</div>
          {price('basic') && (
            <div class="plan__price">
              <span class="plan__price-num">{price('basic')}</span>
              <span class="plan__price-per">{currency} / mes</span>
            </div>
          )}
          <p class="plan__tag">Para los que están empezando a laburar con esto.</p>
        </header>
        <ul class="plan__feats">
          <li><span class="plan__check">✓</span> 3 herramientas por mes</li>
          <li><span class="plan__check">✓</span> Acceso a todas las <em>free</em></li>
          <li><span class="plan__check">✓</span> Cancelás cuando quieras</li>
        </ul>
        <a href={subscribeHref} class="btn btn--ghost plan__cta">Empezar Oficial</a>
      </article>

      <article class="plan plan--featured reveal">
        <div class="plan__glow" aria-hidden="true"></div>
        <div class="plan__ribbon">Recomendado</div>
        <header class="plan__head">
          <div class="plan__name">Maestro</div>
          {price('pro') && (
            <div class="plan__price">
              <span class="plan__price-num">{price('pro')}</span>
              <span class="plan__price-per">{currency} / mes</span>
            </div>
          )}
          <p class="plan__tag">Para los que ya trabajan con esto todos los días.</p>
        </header>
        <ul class="plan__feats">
          <li><span class="plan__check">✓</span> Acceso ilimitado a toda la biblioteca</li>
          <li><span class="plan__check">✓</span> Nuevas herramientas cada semana</li>
          <li><span class="plan__check">✓</span> Cursos y módulos cuando lancen (sin costo extra)</li>
          <li><span class="plan__check">✓</span> Cancelás cuando quieras, sin preguntas</li>
        </ul>
        <a href={subscribeHref} class="btn btn--primary plan__cta">
          Empezar Maestro
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="plan__note mono">Pago vía {PROVIDER_LABEL[REGION_PROVIDER[region]]} &middot; suscripción recurrente</p>
      </article>
    </div>

    {pricing?.providers.lemonsqueezy && (
      <p class="pricing__alt">
        {region === 'ar' ? '¿Pagás desde fuera de Argentina?' : '¿Estás en Argentina?'}
        {' '}<a href={`/suscripcion?region=${other}`}>Ver precios en {otherCurrency}</a>
      </p>
    )}
  </div>
</section>

<style>
  .pricing {
    padding-block: clamp(60px, 8vw, 120px);
  }
  .pricing__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }
  .pricing__title {
    font-size: clamp(34px, 5vw, 56px);
    margin-top: 12px;
  }
  .pricing__title-em {
    background: linear-gradient(180deg, var(--ember-300), var(--ember-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }
  .pricing__desc {
    margin-top: 16px;
    color: var(--ink-dim);
  }

  .pricing__alt {
    margin-top: 28px;
    text-align: center;
    color: var(--ink-mute);
    font-size: 14px;
  }
  .pricing__alt a { color: var(--ember-300); }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (min-width: 780px) {
    .pricing__grid { grid-template-columns: repeat(3, 1fr); align-items: stretch; }
  }

  .plan {
    position: relative;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow: hidden;
    isolation: isolate;
  }
  .plan--featured {
    border-color: rgba(255,176,103,0.3);
    background: linear-gradient(180deg, rgba(255,122,0,0.05), rgba(255,122,0,0.01));
  }
  .plan__glow {
    position: absolute;
    inset: -40%;
    background: radial-gradient(circle at 50% 0%, var(--ember-glow), transparent 55%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }
  .plan > * { position: relative; z-index: 1; }

  .plan__ribbon {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 4px 10px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--ember-500), var(--ember-600));
    color: #1a0e00;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    z-index: 2;
  }

  .plan__name {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 12px;
  }
  .plan__price-num {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .plan__price-per {
    color: var(--ink-mute);
    font-size: 14px;
  }
  .plan__tag {
    margin-top: 8px;
    color: var(--ink-dim);
    font-size: 14px;
  }

  .plan__feats {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14.5px;
    color: var(--ink);
    flex: 1;
  }
  .plan__feats li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .plan__check {
    color: var(--ember-500);
    font-weight: 600;
    width: 20px;
    display: inline-grid;
    place-items: center;
    line-height: 1;
    padding-top: 3px;
  }

  .plan__cta { justify-content: center; margin-top: 4px; }
  .plan__note {
    margin-top: 8px;
    text-align: center;
    color: var(--ink-mute);
    font-size: 11px;
  }
</style>
