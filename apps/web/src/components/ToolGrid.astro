---
import { tools } from '~/data/tools';
import ToolCard from './ToolCard.astro';

const categories = ['Todas', ...Array.from(new Set(tools.map((t) => t.category)))];
---

<section id="herramientas" class="grid-section">
  <div class="container">
    <header class="grid-section__head reveal">
      <div>
        <div class="eyebrow">Biblioteca &middot; {tools.length} recursos</div>
        <h2 class="grid-section__title display">Todo el catálogo, a la vista.</h2>
        <p class="grid-section__desc">
          Podés ver todo sin registrarte. Para abrir video y prompt de cada herramienta,
          entrás con Google. Dos gratis por mes. El resto con suscripción.
        </p>
      </div>

      <div class="grid-section__filters" role="tablist" aria-label="Filtrar por categoría">
        {categories.map((cat, i) => (
          <button
            class:list={['chip', { 'chip--active': i === 0 }]}
            data-filter={cat}
            role="tab"
            aria-selected={i === 0}
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <div class="grid reveal" id="tool-grid">
      {tools.map((t) => (
        <div class="grid__cell" data-cat={t.category}>
          <ToolCard tool={t} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid-section {
    padding-block: clamp(60px, 8vw, 120px);
  }
  .grid-section__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
  }
  .grid-section__title {
    font-size: clamp(34px, 5vw, 56px);
    margin-top: 12px;
  }
  .grid-section__desc {
    color: var(--ink-dim);
    max-width: 560px;
    margin-top: 12px;
    font-size: 16px;
  }
  .grid-section__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255,255,255,0.02);
    color: var(--ink-dim);
    font-size: 13px;
    transition: all 220ms var(--ease-out);
  }
  .chip:hover { color: var(--ink); border-color: var(--ink-mute); }
  .chip--active {
    background: linear-gradient(180deg, rgba(255,122,0,0.15), rgba(255,122,0,0.05));
    border-color: rgba(255,176,103,0.4);
    color: var(--ember-300);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .grid__cell { display: contents; }
  .grid__cell > * { transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out); }
  .grid__cell.is-hidden > * {
    display: none;
  }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .grid__cell { display: block; }
  }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .grid-section__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cells = document.querySelectorAll<HTMLElement>('.grid__cell');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.filter;
      chips.forEach((c) => {
        c.classList.toggle('chip--active', c === chip);
        c.setAttribute('aria-selected', c === chip ? 'true' : 'false');
      });
      cells.forEach((cell) => {
        const match = cat === 'Todas' || cell.dataset.cat === cat;
        cell.classList.toggle('is-hidden', !match);
      });
    });
  });
</script>
