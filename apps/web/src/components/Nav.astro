---
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const user = session?.user;
const displayName = user?.name?.split(' ')[0] ?? user?.email ?? null;
---

<nav class="nav" id="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="La Forja — inicio">
      <span class="nav__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M4 20 L14 10 M11 7 L17 13 M15 3 L21 9 L17 13" stroke="url(#g)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <defs>
            <linearGradient id="g" x1="0" y1="0" x2="24" y2="24">
              <stop offset="0" stop-color="#FFB067"/>
              <stop offset="1" stop-color="#FF7A00"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="nav__wordmark">La Forja</span>
    </a>

    <div class="nav__links" id="nav-links">
      <a href="/#herramientas">Herramientas</a>
      <a href="/cursos">Cursos</a>
      <a href="/rutas">Rutas</a>
      <a href="/#suscripcion">Suscripción</a>
      <a href="/#faq">FAQ</a>
    </div>

    <div class="nav__cta">
      {user ? (
        <>
          <a href="/dashboard" class="nav__user" title={`Mi cuenta (${user.email ?? ''})`}>
            {user.image && <img class="nav__avatar" src={user.image} alt="" />}
            <span class="nav__username">{displayName}</span>
          </a>
          <button id="nav-signout" class="btn btn--ghost" type="button">Salir</button>
        </>
      ) : (
        <a href="/login" class="btn btn--ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v3h20v-3c0-3.33-6.67-5-10-5z" fill="currentColor" opacity=".8"/></svg>
          Ingresar
        </a>
      )}
      <button
        id="nav-toggle"
        class="nav__toggle"
        type="button"
        aria-controls="nav-links"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="nav__toggle-bar" aria-hidden="true"></span>
        <span class="nav__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 14px;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: linear-gradient(180deg, rgba(10,9,8,0.75), rgba(10,9,8,0.35));
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .nav__mark {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: linear-gradient(180deg, var(--bg-elev-2), var(--bg-elev));
    border: 1px solid var(--line-strong);
    box-shadow: 0 0 24px -8px var(--ember-glow);
  }
  .nav__wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .nav__links {
    display: none;
    gap: 32px;
    color: var(--ink-dim);
    font-size: 14px;
  }
  .nav__links a {
    position: relative;
    transition: color 200ms var(--ease-out);
  }
  .nav__links a:hover { color: var(--ink); }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -6px;
    height: 1px;
    background: var(--ember-500);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms var(--ease-out);
  }
  .nav__links a:hover::after { transform: scaleX(1); }

  .nav__cta { display: flex; align-items: center; gap: 12px; }

  .nav__user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--ink-dim);
    font-size: 13px;
    transition: border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .nav__user:hover { border-color: var(--line-strong); color: var(--ink); }
  .nav__avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }
  .nav__username {
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav__toggle {
    display: inline-grid;
    place-content: center;
    gap: 6px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-elev);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 200ms var(--ease-out);
  }
  .nav__toggle:hover { border-color: var(--line-strong); }
  .nav__toggle-bar {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 260ms var(--ease-out);
  }
  .nav[data-open] .nav__toggle-bar:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav[data-open] .nav__toggle-bar:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  @media (max-width: 479.98px) {
    .nav__avatar + .nav__username { display: none; }
    .nav__user:has(.nav__avatar) { padding-right: 4px; }
  }

  @media (max-width: 779.98px) {
    /* .container es position: relative; sin esto el panel se ancla al inner y pisa el padding del nav. */
    .nav__inner { position: static; }
    .nav[data-open] .nav__links {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 8px clamp(20px, 4vw, 40px) 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(0, 0, 0, 0.8);
      font-size: 16px;
    }
    .nav[data-open] .nav__links a {
      padding-block: 14px;
      border-bottom: 1px solid var(--line);
    }
    .nav[data-open] .nav__links a:last-child { border-bottom: 0; }
    .nav[data-open] .nav__links a::after { display: none; }
  }

  @media (min-width: 780px) {
    .nav__links { display: inline-flex; }
    .nav__toggle { display: none; }
  }
</style>

<script>
  import { signOut } from 'auth-astro/client';
  document.getElementById('nav-signout')?.addEventListener('click', () => {
    signOut();
  });

  const nav = document.getElementById('nav');
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  if (nav && toggle && links) {
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };

    toggle.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')));
    // Los links a anclas (/#faq) no recargan la página, así que el menú quedaría abierto tapando la sección.
    links.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (nav.hasAttribute('data-open') && !nav.contains(e.target as Node)) setOpen(false);
    });
    matchMedia('(min-width: 780px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
