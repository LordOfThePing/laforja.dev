# Secreto compartido con apps/api — la web firma el JWT que valida la API.
# En dev usá algo random largo. Debe ser exactamente igual al AUTH_SECRET
# de apps/api/.env.
AUTH_SECRET=cambiame-por-un-secreto-largo

# Credenciales de OAuth de Google Cloud Console.
# Callback autorizado en la consola: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL base pública del sitio (SEO, links absolutos).
PUBLIC_SITE_URL=http://localhost:3000

# URL de la API vista desde el servidor de Astro (en compose: http://api:4000).
# El browser nunca habla directo con la API: el JWT se firma y se usa del lado del servidor.
API_URL=http://localhost:4000
